<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ==================== HEADER BRANDING ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Ai Marco coc"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autonomous Vision AI • Pure Loot Farming • 0-Training"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 1. PERMISSION SETUP WIZARD ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_cyber_active"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ 1. SETUP WIZARD &amp; PERMISSIONS"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Grant required Android services to enable the floating HUD &amp; gestures."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <!-- Permission Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_grant_overlay"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="1. OVERLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_grant_accessibility"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="2. ACCESSIBILITY"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 2. AI VISION & LIVE MODEL HUB ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_cyber"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 2. AI VISION ENGINE &amp; LIVE MODELS"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Zero fixed models — queries live /models on your API key with latency ping."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select AI Provider:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinner_provider"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Live Models on Key:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinner_live_models"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:padding="8dp" />

            <EditText
                android:id="@+id/et_api_key_input"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Paste Gemini / OpenRouter / Groq / DeepSeek Key"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />

            <!-- Key Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_api_key"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="+ ADD KEY"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_ping_api_key"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_btn_emerald"
                    android:text="⚡ FETCH LIVE MODELS &amp; PING"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ping_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1E293B"
                android:padding="8dp"
                android:text="⚡ Status: Ready to fetch live models &amp; test ping"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ==================== 3. PURE LOOT TARGETS ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_cyber"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 3. PURE LOOT TARGETS (NO TROPHY LIMITS)"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="On-Device OCR &amp; Vision targets collectors/storages for instant loot extraction."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Min Gold: 500k"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Min Elixir: 500k"
                    android:textColor="#EC4899"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Min Dark: 4k"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 4. 2-WAY TELEGRAM REMOTE ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_cyber"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 4. 2-WAY TELEGRAM REMOTE CONTROL"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Control your farming bot via /status, /pause, /resume, /attack, /walls, /schedule"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_telegram_bot_token"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Telegram Bot Token"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_telegram_chat_id"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Telegram Chat ID (e.g. @aaafreecloud)"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_send_telegram_test"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="DISPATCH TELEGRAM TEST PING"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ==================== 5. LAUNCH PLAY MODE ==================== -->
        <Button
            android:id="@+id/btn_start_floating_hud"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_emerald"
            android:text="🚀 LAUNCH MACRORIFY PLAY MODE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
