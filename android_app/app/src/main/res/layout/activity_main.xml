<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B14">

    <!-- Top Header Banner with Logo & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0D1527"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ai Marco coc"
                android:textColor="#F59E0B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Village AI Macro • Multi-Touch • 265+ Assets"
                android:textColor="#38BDF8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="PRO UNLOCKED"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4-Tab Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#0A101D">

        <Button
            android:id="@+id/tab_btn_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#2563EB"
            android:text="🏰 DASHBOARD"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/tab_btn_strategy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#131C2E"
            android:text="⚔️ STRATEGY"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/tab_btn_clan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#131C2E"
            android:text="🏡 VILLAGE &amp; CLAN"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/tab_btn_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#131C2E"
            android:text="🧠 VISION AI"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TAB 1: DASHBOARD -->
            <LinearLayout
                android:id="@+id/tab_content_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Service Status Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_accessibility_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Accessibility Service: CHECKING..."
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_grant_accessibility"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#2563EB"
                            android:text="1. Accessibility"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btn_grant_overlay"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="#2563EB"
                            android:text="2. Overlay"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Launch Floating Controller Button -->
                <Button
                    android:id="@+id/btn_start_floating_hud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#10B981"
                    android:text="🚀 START MACRO &amp; LAUNCH CLASH OF CLANS"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Multi-Touch Engine Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖐️ Multi-Touch Gestures &amp; Panic Stop"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• 4-Finger Wave: Simultaneous dragon &amp; balloon line drop&#10;• 2-Finger Funnel: King &amp; Queen corner drops in 1ms&#10;• 🚨 Panic Stop: Press Volume Down key to halt instantly"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Supervisor & Stats Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Home Village Battle Statistics &amp; AI Memory"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_memory_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Total Raids: 0 | Win Rate: 100% | Optimal Angle: BOTTOM_LEFT&#10;Auto-Crash &amp; Sync Recovery: ON | 265+ Assets: LOADED"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 2: STRATEGY & TACTICS -->
            <LinearLayout
                android:id="@+id/tab_content_strategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚔️ Home Village Tactical Army Strategies"
                    android:textColor="#F59E0B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Strategy Picker -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Active Home Village Strategy:"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_strategy_picker"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="#1E293B" />

                <!-- Minimum Loot Filters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Home Village Loot Filters"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Min Gold: 500,000 | Min Elixir: 500,000 | Min Dark: 4,000"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Air Sweeper Avoidance: AUTOMATIC (Flank/Rear Entry Calculation)"
                        android:textColor="#10B981"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 3: HOME VILLAGE & CLAN AUTOMATION -->
            <LinearLayout
                android:id="@+id/tab_content_clan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏡 Home Village &amp; Clan Automation Suite"
                    android:textColor="#38BDF8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Clan Tools Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤝 Clan Chat Auto-Donate &amp; CC Request"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_donate_now"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#2563EB"
                        android:text="🤝 RUN AUTO-DONATE SCAN NOW"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_cc_request"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#6366F1"
                        android:text="🛡️ REQUEST CLAN CASTLE REINFORCEMENTS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Base Maintenance Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💎 Base Maintenance &amp; Resource Harvesting"
                        android:textColor="#10B981"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_clean_obstacles"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#10B981"
                        android:text="💎 CLEAN GEM BOXES &amp; OBSTACLES NOW"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_collect_loot"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#F59E0B"
                        android:text="💰 COLLECT MINES, DRILLS &amp; TREASURY"
                        android:textColor="#070B14"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 4: VISION AI & ASSETS -->
            <LinearLayout
                android:id="@+id/tab_content_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Multimodal Vision AI &amp; 265+ Asset Hub"
                    android:textColor="#38BDF8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Provider Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Select AI Provider:"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_provider"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="#1E293B" />

                <!-- API Key Input + Add Button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Add API Key (Free tier supported):"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/et_api_key_input"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="#1E293B"
                        android:hint="Paste API Key here..."
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:paddingHorizontal="10dp"
                        android:textSize="11sp"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/btn_add_api_key"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#10B981"
                        android:text="+ ADD"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_active_keys_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="API Key Pool: 0 Key(s) Loaded (Auto-Rotation Active)"
                    android:textColor="#10B981"
                    android:textSize="11sp" />

                <!-- Live Model Discovery -->
                <Button
                    android:id="@+id/btn_fetch_models"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#6366F1"
                    android:text="🔄 FETCH LIVE MODELS"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_live_models"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="#1E293B" />

                <!-- Screenshot-to-Code Tester -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#131C2E"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸 Screenshot-to-Code Vision Engine"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_test_vision"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#F59E0B"
                        android:text="⚡ TEST SCREENSHOT VISION AI"
                        android:textColor="#070B14"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_vision_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#070B14"
                        android:padding="8dp"
                        android:text="Vision Status: Ready. 265+ Supercell Datamined Assets active."
                        android:textColor="#E2E8F0"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
