<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:orientation="vertical">

    <!-- ==================== TOP CYBER HEADER ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0F172A"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:text="👑"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="AI MARCO COC"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CognitivePeak AI • Multi-Account &amp; Watchdog"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_header_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="v9.0 PRO"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ==================== SEGMENTED TAB BAR ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tab_bar"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/tab_btn_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active_pill"
            android:text="CONTROLLER"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_btn_strategy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="STRATEGY"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_btn_clan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="VILLAGE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_btn_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="AI &amp; API"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ==================== TAB CONTENT CONTAINER ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== TAB 1: CONTROLLER DASHBOARD ==================== -->
            <LinearLayout
                android:id="@+id/tab_content_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- System Permission Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ SYSTEM PERMISSIONS"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_grant_accessibility"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:text="ACCESSIBILITY"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_grant_overlay"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_emerald"
                            android:text="OVERLAY PERM"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hero Start Button Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_start_floating_hud"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_btn_gold"
                        android:text="🚀 START AI CONTROLLER"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Launches Floating Overlay &amp; Clash of Clans automatically"
                        android:textColor="#64748B"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Telemetry Stats Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 HOME VILLAGE TELEMETRY"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Pure Home Village 24/7 Loot Farming\n• Dedicated Free Builder Wall Upgrade Dump\n• 4-Finger Multi-Touch Deployment &amp; Giga Protection\n• Automatic Multi-Account Supercell ID Rotation"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== TAB 2: PRO META STRATEGY ==================== -->
            <LinearLayout
                android:id="@+id/tab_content_strategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber_active"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ SELECT META STRATEGY"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_strategy_picker"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tv_strategy_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="🎥 Source: Pro Clash World Championship"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_strategy_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Deploys Root Riders with Valkyries behind an Overgrowth Spell and Grand Warden Eternal Tome protection."
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tv_strategy_comp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Army: 8 Root Riders, 10 Valkyries, 2 Apprentices, 4 Healers"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== TAB 3: TELEGRAM REMOTE & CLAN ==================== -->
            <LinearLayout
                android:id="@+id/tab_content_clan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Telegram Remote Hub Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber_active"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 TELEGRAM 2-WAY REMOTE CONTROL"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Bot Token &amp; Chat ID:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_telegram_bot_token"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:text="8841143616:AAGbcJKf3MLTN17-tpmwhZKZQIIbErDT1PA"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_telegram_chat_id"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:text="-1004447017934"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_send_telegram_test"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_primary"
                        android:text="📡 SEND TELEGRAM TEST PING"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- One-Tap Village Routines Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ ONE-TAP MACRO ROUTINES"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_collect_loot"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_gold"
                        android:text="💰 COLLECT MINES &amp; TREASURY"
                        android:textColor="#0F172A"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_upgrade_walls"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_emerald"
                        android:text="🧱 DUMP LOOT INTO WALLS"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_donate_now"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_primary"
                        android:text="🤝 AUTO-DONATE TO CLAN"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_cc_request"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_dark"
                        android:text="🛡️ REQUEST CC TROOPS"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_trigger_clean_obstacles"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_dark"
                        android:text="💎 CLEAR GEM BOXES &amp; OBSTACLES"
                        android:textColor="#E2E8F0"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== TAB 4: VISION AI & API KEY MANAGER ==================== -->
            <LinearLayout
                android:id="@+id/tab_content_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- On-Device AI Status Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 ON-DEVICE NEURAL VISION ENGINE"
                        android:textColor="#34D399"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_vision_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✓ 12.0 MB Quantized TFLite Model Online\n✓ 285+ Supercell Building Sprites Active\n✓ 0.0ms Local Latency (Zero Internet Needed)"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Cloud LLM API Key & Ping Manager Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_cyber_active"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔑 CLOUD LLM KEY MANAGER &amp; TEST PING"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Select AI Provider:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinner_provider"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Model Name / Endpoint:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinner_live_models"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp" />

                    <EditText
                        android:id="@+id/et_api_key_input"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Paste Gemini / Groq / OpenRouter API Key"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:paddingHorizontal="10dp"
                        android:textSize="12sp" />

                    <!-- Key Action Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_add_api_key"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:text="+ ADD KEY"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_ping_api_key"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1.2"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_emerald"
                            android:text="⚡ TEST PING"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ping Test Result Banner -->
                    <TextView
                        android:id="@+id/tv_ping_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#1E293B"
                        android:padding="8dp"
                        android:text="⚡ Status: Ready to Test API Key Ping"
                        android:textColor="#38BDF8"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_active_keys_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Active Keys in Pool: 0"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_clear_keys"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_btn_dark"
                            android:paddingHorizontal="10dp"
                            android:text="🗑️ CLEAR"
                            android:textColor="#EF4444"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
