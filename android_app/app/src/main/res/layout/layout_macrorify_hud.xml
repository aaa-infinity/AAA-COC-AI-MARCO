<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/macrorify_root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ==================== 1. MINIMIZED BUBBLE MODE (42dp) ==================== -->
    <LinearLayout
        android:id="@+id/ll_minimized_bubble"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_macrorify_bubble"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ==================== 2. EXPANDED PLAY MODE TOOLBAR (8-BUTTONS) ==================== -->
    <LinearLayout
        android:id="@+id/ll_expanded_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:background="@drawable/bg_macrorify_capsule"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:visibility="visible">

        <!-- 1. [👆 Drag/Collapse] -->
        <Button
            android:id="@+id/btn_hud_collapse"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="👆"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <!-- 2. [▶/⏸ Play/Pause] -->
        <Button
            android:id="@+id/btn_hud_play_pause"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_macrorify_btn_active"
            android:text="▶"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 3. [⏹ Stop] -->
        <Button
            android:id="@+id/btn_hud_stop"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="⏹"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 4. Live Status Pill Badge -->
        <TextView
            android:id="@+id/tv_hud_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="READY"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 5. [⚙ In-Game Settings Modal] -->
        <Button
            android:id="@+id/btn_hud_settings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="⚙"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- 6. [🛠️ Auto Screen Off / Black Screen Saver] -->
        <Button
            android:id="@+id/btn_hud_screen_off"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="🛠️"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- 7. [▶_ Live AI Console Log] -->
        <Button
            android:id="@+id/btn_hud_console"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="▶_"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 8. [❌ Exit Play Mode] -->
        <Button
            android:id="@+id/btn_hud_exit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_macrorify_btn"
            android:text="❌"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
