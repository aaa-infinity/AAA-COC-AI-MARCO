<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_capsule"
    android:padding="8dp">

    <!-- Top Action Toolbar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1. Play / Pause Button (Gold Glow) -->
        <Button
            android:id="@+id/btn_toggle_play"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_gold"
            android:text="▶"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <!-- 2. Vision Neural Engine -->
        <Button
            android:id="@+id/btn_hud_vision"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_primary"
            android:text="👁️"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="0dp" />

        <!-- 3. Wall Dump & Tools -->
        <Button
            android:id="@+id/btn_hud_tools"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_emerald"
            android:text="🧱"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="0dp" />

        <!-- 4. Telemetry / Info Console -->
        <Button
            android:id="@+id/btn_hud_console"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_dark"
            android:text="📊"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="0dp" />

        <!-- 5. Close / Exit Button -->
        <Button
            android:id="@+id/btn_hud_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_dark"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Sub-badge with live Status & Active Strategy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_hud_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ [IDLE] Root Smash"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="4dp" />

        <Button
            android:id="@+id/btn_strategy"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_btn_dark"
            android:text="STRATEGY"
            android:textColor="#F59E0B"
            android:textSize="8sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp" />
    </LinearLayout>

</LinearLayout>
